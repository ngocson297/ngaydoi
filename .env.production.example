# Database
POSTGRES_DB=ngaydoi
POSTGRES_USER=ngaydoi
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Public deployment
PUBLIC_PORT=8080
FRONTEND_URL=https://wedding.example.com
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://api:4000/api
PUBLIC_APP_URL=https://wedding.example.com
API_PORT=4000
NODE_ENV=production
APP_VERSION=0.13.1
RELEASE_SHA=replace-with-git-commit-sha
TRUST_PROXY_HOPS=1

# Authentication — generate unique random secrets
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30
REQUIRE_EMAIL_VERIFICATION=true
COOKIE_SECURE=true

# Background delivery
JOB_RUNNER_ENABLED=true
JOB_POLL_INTERVAL_MS=10000
OPERATIONS_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
WEBHOOK_TIMEOUT_MS=10000

# Email provider
MAIL_PROVIDER=RESEND
MAIL_FROM=Ngay Doi <hello@example.com>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# S3-compatible storage: AWS S3, Cloudflare R2, MinIO gateway...
STORAGE_PROVIDER=S3
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=ngaydoi-production
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_PUBLIC_BASE_URL=https://media.example.com

# Payments — sandbox must be false in production
PAYMENT_SANDBOX_ENABLED=false
BANK_NAME=Your Bank
BANK_ACCOUNT_NAME=YOUR BUSINESS NAME
BANK_ACCOUNT_NUMBER=0000000000

# Backup retention
BACKUP_ROOT=../ngaydoi-local-data/backups
BACKUP_RETENTION_COUNT=14
