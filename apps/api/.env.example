DATABASE_URL=postgresql://ngaydoi:ngaydoi_dev_password@127.0.0.1:5432/ngaydoi
API_PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-this-local-access-secret-to-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30
REQUIRE_EMAIL_VERIFICATION=true
COOKIE_SECURE=false
NODE_ENV=development

# Local media storage for development
UPLOAD_DIR=../../../ngaydoi-local-data/uploads

# Phase 6 commercial sandbox
PAYMENT_SANDBOX_ENABLED=true
BANK_NAME=Ngân hàng Demo
BANK_ACCOUNT_NAME=NGAY DOI DEMO
BANK_ACCOUNT_NUMBER=0123456789

# Phase 7 production readiness
APP_VERSION=0.15.1
RELEASE_SHA=development
TRUST_PROXY_HOPS=1
JOB_RUNNER_ENABLED=true
JOB_POLL_INTERVAL_MS=10000
OPERATIONS_ENCRYPTION_KEY=local-development-operations-key-change-me
WEBHOOK_TIMEOUT_MS=10000

# Development email: writes safe metadata to API logs and marks outbox delivered
MAIL_PROVIDER=CONSOLE
MAIL_FROM=Ngày Đôi <hello@localhost>
# RESEND_API_KEY=

# Development storage. Production must use S3-compatible storage.
STORAGE_PROVIDER=LOCAL
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Phase 9 custom domain
CUSTOM_DOMAIN_CNAME_TARGET=domains.ngaydoi.local

# Shared memories limits
MEMORY_ALBUM_MAX_ITEMS=1000
MEMORY_ALBUM_MAX_BYTES=5368709120

# Phase 13 planning reminders (minimum effective interval: 15 minutes)
PLANNING_REMINDER_INTERVAL_MS=3600000
