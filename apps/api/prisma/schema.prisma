enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum PartnerMemberRole {
  OWNER
  MANAGER
  MEMBER
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAYABLE
  PAID
  VOID
}

enum PayoutStatus {
  REQUESTED
  REVIEWING
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELED
}

model PartnerOrganization {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  status            PartnerStatus @default(PENDING)
  contactEmail      String
  contactPhone      String?
  website           String?
  logoUrl           String?
  brandName         String?
  primaryColor      String         @default("#7A3045")
  hideNgayDoiBrand  Boolean        @default(false)
  commissionRateBps Int            @default(1000)
  minimumPayout     Int            @default(500000)
  approvedAt        DateTime?
  approvedById      String?
  suspendedAt       DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, createdAt])
}

model PartnerMember {
  id             String            @id @default(cuid())
  partnerId      String
  userId         String
  role           PartnerMemberRole @default(MEMBER)
  active         Boolean           @default(true)
  invitedAt      DateTime           @default(now())
  joinedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([partnerId, userId])
  @@index([userId, active])
  @@index([partnerId, role])
}

model PartnerClient {
  id          String   @id @default(cuid())
  partnerId   String
  customerId  String
  weddingId   String?
  source      String   @default("PARTNER_PORTAL")
  externalRef String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([partnerId, customerId, weddingId])
  @@index([partnerId, createdAt])
  @@index([customerId])
  @@index([weddingId])
}

model PartnerCommission {
  id             String           @id @default(cuid())
  partnerId      String
  orderId        String?
  customerId     String?
  weddingId      String?
  description    String
  baseAmount     Int
  rateBps        Int
  commissionAmount Int
  status         CommissionStatus @default(PENDING)
  availableAt    DateTime?
  approvedAt     DateTime?
  paidAt         DateTime?
  payoutId       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([partnerId, orderId])
  @@index([partnerId, status, createdAt])
  @@index([payoutId])
}

model PartnerPayout {
  id            String       @id @default(cuid())
  partnerId     String
  requestedById String
  reviewedById  String?
  amount        Int
  status        PayoutStatus @default(REQUESTED)
  bankName      String
  accountName   String
  accountNumberMasked String
  note          String?
  rejectionReason String?
  requestedAt   DateTime     @default(now())
  reviewedAt    DateTime?
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([partnerId, status, requestedAt])
}

enum CheckinStationStatus {
  ACTIVE
  DISABLED
}

model SeatingTable {
  id          String            @id @default(cuid())
  weddingId   String
  wedding     Wedding           @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  eventId     String?
  event       Event?            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventKey    String            @default("WEDDING")
  name        String
  code        String
  capacity    Int               @default(10)
  zone        String?
  shape       SeatingTableShape @default(ROUND)
  note        String?
  sortOrder   Int               @default(0)
  assignments SeatAssignment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([weddingId, eventKey, code])
  @@index([weddingId, eventKey, sortOrder])
  @@index([eventId])
}

model SeatAssignment {
  id          String       @id @default(cuid())
  weddingId   String
  wedding     Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  eventId     String?
  event       Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventKey    String       @default("WEDDING")
  tableId     String
  table       SeatingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  guestId     String
  guest       Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  seatCount   Int          @default(1)
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([guestId, eventKey])
  @@index([weddingId, eventKey])
  @@index([tableId])
}

model CheckinStation {
  id          String               @id @default(cuid())
  weddingId   String
  wedding     Wedding              @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  eventId     String?
  event       Event?               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventKey    String               @default("WEDDING")
  name        String
  token       String               @unique
  status      CheckinStationStatus @default(ACTIVE)
  lastUsedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  records     CheckinRecord[]

  @@index([weddingId, eventKey, status])
  @@index([eventId])
}

model CheckinRecord {
  id           String         @id @default(cuid())
  weddingId    String
  wedding      Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  eventId      String?
  event        Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventKey     String         @default("WEDDING")
  guestId      String
  guest        Guest          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  invitationId String?
  invitation   Invitation?    @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  stationId    String?
  station      CheckinStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  method       CheckinMethod  @default(MANUAL)
  adultCount   Int            @default(1)
  childCount   Int            @default(0)
  note         String?
  checkedInAt  DateTime       @default(now())
  checkedOutAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([guestId, eventKey])
  @@index([weddingId, eventKey, checkedInAt])
  @@index([stationId, checkedInAt])
}



enum MemoryAssetStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum MemoryAssetType {
  IMAGE
  VIDEO
}

model MemoryAlbum {
  id                 String        @id @default(cuid())
  weddingId          String        @unique
  wedding            Wedding       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  token              String        @unique
  title              String        @default("Khoảnh khắc cùng nhau")
  description        String        @default("Cùng góp những bức ảnh và video đáng nhớ trong ngày vui của chúng mình.")
  thankYouTitle      String        @default("Cảm ơn bạn đã chung vui")
  thankYouMessage    String        @default("Mỗi khoảnh khắc bạn chia sẻ đều là một món quà thật quý giá với chúng mình.")
  uploadEnabled      Boolean       @default(true)
  publicEnabled      Boolean       @default(true)
  moderationRequired Boolean       @default(true)
  showUploaderName   Boolean       @default(true)
  closesAt           DateTime?
  assets             MemoryAsset[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([publicEnabled, uploadEnabled])
}

model MemoryAsset {
  id              String            @id @default(cuid())
  albumId         String
  album           MemoryAlbum       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  invitationId    String?
  invitation      Invitation?       @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  type            MemoryAssetType
  status          MemoryAssetStatus @default(PENDING)
  storageKey      String
  publicUrl       String
  mimeType        String
  sizeBytes       Int
  originalName    String
  uploaderName    String?
  uploaderMessage String?
  width           Int?
  height          Int?
  rejectionReason String?
  moderationNote  String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([albumId, status, createdAt])
  @@index([invitationId, createdAt])
}

model PlanningTask {
  id                 String               @id @default(cuid())
  weddingId          String
  wedding            Wedding              @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  category           PlanningTaskCategory @default(OTHER)
  priority           PlanningTaskPriority @default(NORMAL)
  status             PlanningTaskStatus   @default(TODO)
  source             PlanningTaskSource   @default(CUSTOM)
  dueAt               DateTime?
  assigneeName        String?
  sortOrder           Int                  @default(0)
  reminderEnabled    Boolean              @default(true)
  reminderDaysBefore Int                  @default(3)
  lastReminderAt     DateTime?
  completedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([weddingId, status, dueAt])
  @@index([weddingId, category, sortOrder])
  @@index([reminderEnabled, status, dueAt])
}

