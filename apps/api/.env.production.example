# Ngày Đôi production template — Sprint 15.15
NODE_ENV=production
API_PORT=4000
APP_VERSION=0.15.14
RELEASE_SHA=replace-with-git-sha

# Managed PostgreSQL only. Do not point production to localhost.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Public web origins, comma-separated when needed.
FRONTEND_URL=https://ngaydoi.vn
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1
REQUIRE_EMAIL_VERIFICATION=true

# Authentication / security — replace every placeholder with a unique secret.
JWT_ACCESS_SECRET=replace-with-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30
OPERATIONS_ENCRYPTION_KEY=replace-with-random-secret-at-least-32-characters
MEMORY_UPLOAD_SIGNING_SECRET=replace-with-random-secret-at-least-32-characters
MEMORY_ACTOR_PEPPER=replace-with-random-secret-at-least-32-characters

# Production mail
MAIL_PROVIDER=RESEND
MAIL_FROM=Ngày Đôi <hello@ngaydoi.vn>
RESEND_API_KEY=replace-with-resend-key

# Media: guest phone -> S3/R2 -> CDN -> album
STORAGE_PROVIDER=R2
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=ngaydoi-production
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_PUBLIC_BASE_URL=https://media.ngaydoi.vn

# Commercial safety
PAYMENT_SANDBOX_ENABLED=false
BANK_NAME=replace-with-production-bank
BANK_ACCOUNT_NAME=replace-with-production-account-name
BANK_ACCOUNT_NUMBER=replace-with-production-account-number

# Background processing / webhook delivery
JOB_RUNNER_ENABLED=true
JOB_POLL_INTERVAL_MS=10000
WEBHOOK_TIMEOUT_MS=10000

# Wedding social limits
MEMORY_IMAGE_MAX_BYTES=12582912
MEMORY_PROXY_VIDEO_MAX_BYTES=31457280
MEMORY_VIDEO_MAX_BYTES=157286400
MEMORY_UPLOAD_BATCH_MAX_FILES=10
MEMORY_ALBUM_MAX_ITEMS=3000
MEMORY_ALBUM_MAX_BYTES=21474836480
MEMORY_ARCHIVE_MAX_ITEMS=1000
MEMORY_ARCHIVE_MAX_BYTES=5368709120

PLANNING_REMINDER_INTERVAL_MS=3600000
CUSTOM_DOMAIN_CNAME_TARGET=domains.ngaydoi.vn
